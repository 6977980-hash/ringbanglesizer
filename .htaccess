# Ring Bangle Sizer theme folder rules (audit 2026-11-07, F-X01 + F-P02).
# Applies only to files under wp-content/themes/ringbanglesizer/.

# F-X01: repo files that are not part of the site (notes, build scripts, test harness, CI config).
<FilesMatch "\.(md|py|json|yml|yaml|lock|sh|dist|log|html)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^(docs|tools|\.github)(/|$) - [F,L]
</IfModule>

# F-P02: css/js are loaded with ?ver=RBS_VERSION, so a new release gets a new URL: cache for a year.
# Images, PDFs and icons keep their file names, so they get 30 days without "immutable".
<IfModule mod_headers.c>
	<FilesMatch "\.(css|js)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico|pdf|woff2?)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
</IfModule>
